/* Layout: shell geometry only. Component appearance lives in components.tcss. */
#topbar { height: 1; padding: 0 1; }
#workspace { height: 1fr; }
#navigation { display: none; }
#conversation { width: 1fr; padding: 1 2 0 2; scrollbar-size-vertical: 1; scrollbar-size-horizontal: 0; scrollbar-color: $fin-graphite; scrollbar-background: $fin-ink; scrollbar-color-hover: $fin-dim; scrollbar-color-active: $fin-ledger; }
#context-rail { display: none; width: 34; padding: 1 2; overflow-y: auto; }
#context-rail.visible { display: block; }
#command-menu { display: none; height: auto; max-height: 9; margin: 0 1; padding: 0 2; }
#command-menu.visible { display: block; }
#composer-row { height: auto; margin: 0 1; }
#composer { width: 1fr; height: auto; min-height: 3; max-height: 10; }
#send { display: none; }
#status { height: 1; margin: 0 1; padding: 0 2; }

Screen.layout-narrow #conversation { padding: 1 2 0 1; }
Screen.layout-narrow #composer-row, Screen.layout-narrow #status, Screen.layout-narrow #command-menu { margin: 0; }
Screen.layout-narrow #context-rail { width: 28; }
