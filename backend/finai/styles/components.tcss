/* Components: one selector block per reusable widget/state. */
#topbar { background: $fin-ink; color: $fin-dim; }
#welcome { margin: 1 0; color: $fin-paper; max-width: 100; }
.rail-title { color: $fin-dim; text-style: bold; margin: 1 0; }
#navigation .nav-item { width: 1fr; min-width: 0; height: 3; padding: 0 1; border: none; background: transparent; color: $fin-dim; content-align: left middle; text-align: left; text-style: none; }
#navigation .nav-item:hover, #navigation .nav-item:focus { background: $fin-graphite; color: $fin-ledger; }
#navigation .nav-item.-active { background: $fin-graphite; color: $fin-paper; text-style: bold; }
#context-rail { border-left: solid $fin-rule; background: $fin-ink; color: $fin-dim; }

.user-message { margin: 1 0 0 0; padding: 0 1; width: auto; max-width: 100%; background: $fin-graphite; color: $fin-paper; height: auto; }
.assistant-message { margin: 1 0 0 0; height: auto; color: $fin-paper; }
.assistant-bullet { width: 2; height: 1; color: $fin-ledger; }
.assistant-body { width: 1fr; height: auto; }
.activity { color: $fin-dim; }
.run-activity { margin: 1 0 0 0; padding: 0; color: $fin-dim; height: auto; }
.command-message { margin: 1 0 0 0; color: $fin-dim; }
.trace-panel { margin: 1 0 0 2; color: $fin-dim; }
.sources-message { margin: 1 0 0 2; color: $fin-dim; height: auto; }
.run-footer { margin: 1 0 0 2; color: $fin-dim; height: auto; }
.error { margin: 0 0 0 2; color: $fin-loss; height: auto; }

ApprovalScreen, SessionScreen, HelpScreen { align: center middle; background: $fin-ink 80%; }
#approval-modal, #help-modal, #session-modal { max-width: 95%; padding: 1 2; border: round $fin-ledger; background: $fin-graphite; color: $fin-paper; }
#approval-modal { width: 70; }
#help-modal { width: 80; }
#session-modal { width: 90; }

#command-menu { color: $fin-dim; background: $fin-graphite; border-top: solid $fin-rule; }
#composer { border: none; border-left: thick $fin-ledger; background: $fin-graphite; color: $fin-paper; padding: 1 1; }
#composer:focus { border: none; border-left: thick $fin-ledger; }
#composer .text-area--cursor-line { background: $fin-graphite; }
#composer .text-area--placeholder { color: $fin-dim; }
#composer .text-area--selection { background: $fin-rule; }
#status { color: $fin-dim; }
