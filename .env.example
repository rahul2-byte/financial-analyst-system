# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_TITLE=Financial Intelligence Platform API
API_VERSION=v1
DEBUG=false
DEFAULT_LLM_MODEL=zai-org/glm-5.3-flash

# -----------------------------------------------------------------------------
# OpenRouter Jev routing (required for Jev routing)
# -----------------------------------------------------------------------------
FINAI_ROUTER_ENABLED=true
FINAI_ROUTER_TIMEOUT_SECONDS=0.75
FINAI_ROUTER_MAX_RETRIES=1
FINAI_ROUTER_MIN_CONFIDENCE=0.60
OPENROUTER_API_KEY=replace_with_openrouter_secret_key
OPENROUTER_JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_JEV_MODEL=~typesafe/jev-latest

# -----------------------------------------------------------------------------
# Hive GLM-5.3-Flash generation (required for model generation)
# -----------------------------------------------------------------------------
HIVE_API_KEY=replace_with_hive_secret_key
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=zai-org/glm-5.3-flash
HIVE_TIMEOUT=600.0
HIVE_CONNECT_TIMEOUT=5.0
HIVE_POOL_TIMEOUT=2.0
HIVE_WRITE_TIMEOUT=10.0
HIVE_READ_TIMEOUT=60.0
HIVE_MAX_RETRIES=2
HIVE_BACKOFF_BASE=0.5
HIVE_BACKOFF_CAP=4.0
HIVE_CIRCUIT_FAILURE_THRESHOLD=3
HIVE_CIRCUIT_RECOVERY_TIMEOUT=30.0
HIVE_MAX_OUTPUT_TOKENS=8192
HIVE_MAX_REPORT_TOKENS=32768
HIVE_MAX_REPAIR_TOKENS=8192
HIVE_REPAIR_TIMEOUT=120.0

# -----------------------------------------------------------------------------
# Research context, data quality, and pipeline
# -----------------------------------------------------------------------------
FINAI_CONTEXT_MAX_TOKENS=250000
FINAI_CONTEXT_COMPACTION_RATIO=0.9
MIN_QUALITY_SCORE=40.0
MARKET_DATA_MAX_AGE_DAYS=7
VENDOR_MAX_RELATIVE_DIFFERENCE=0.02
MAX_ARTICLES_PER_COMPANY=50
PIPELINE_VERSION=1.0.0

# -----------------------------------------------------------------------------
# TinyFish news search (required for live news retrieval)
# -----------------------------------------------------------------------------
TINYFISH_API_KEY=replace_with_tinyfish_api_key
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_SEARCH_TIMEOUT=20.0
TINYFISH_MAX_RESULTS_PER_QUERY=10
TINYFISH_MAX_RETRIES=1
TINYFISH_BACKOFF_SECONDS=0.5

# -----------------------------------------------------------------------------
# Optional Upstox market-data access
# Leave UPSTOX_ACCESS_TOKEN empty when Upstox is not configured.
# -----------------------------------------------------------------------------
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_TIMEOUT=20.0

# -----------------------------------------------------------------------------
# Runtime storage, quotas, and HTTP pool
# -----------------------------------------------------------------------------
FINAI_QUOTA_DB=.finai/quota.sqlite3
FINAI_PROVIDER_REQUESTS_PER_SECOND=2
HTTP_POOL_MAX_CONNECTIONS=10
HTTP_POOL_MAX_KEEPALIVE_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Optional local Phoenix tracing
# Keep disabled unless Phoenix is running locally.
# -----------------------------------------------------------------------------
FINAI_OBSERVABILITY_ENABLED=false
FINAI_PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
FINAI_PHOENIX_PROJECT=fin-ai-local
FINAI_TRACE_CONTENT=redacted_full
FINAI_TRACE_MAX_CONTENT_BYTES=1000000
FINAI_TRACE_SAMPLE_RATE=1.0
